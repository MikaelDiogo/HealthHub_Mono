# Copie para eval/.env (ignorado pelo git) e preencha os valores reais.
# Nunca commite este arquivo com valores reais.

# Mesma chave usada em HealthHub-BackEnd/.env — reaproveite o valor de lá.
GROQ_API_KEY=

# Gerado com: claude setup-token
# Token de longa duração, SÓ para esta avaliação (claude -p em subprocesso).
# Nunca usar este token no backend do HealthHub em produção.
CLAUDE_CODE_OAUTH_TOKEN=

# Opcional — só roda o adaptador "Sonnet via API" se esta variável existir.
# Chave do Console da Anthropic (https://console.anthropic.com), NÃO o setup token acima.
ANTHROPIC_API_KEY=

# Opcional — limita quantas vinhetas rodar (útil para validar o pipeline antes do run completo)
EVAL_LIMIT=
