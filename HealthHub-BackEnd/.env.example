PORT=3001

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Chave da API GROQ
GROQ_API_KEY=

# URL de conexão com o PostgreSQL. Se DATABASE_URL estiver definida (não vazia), ela tem PRIORIDADE e os campos DB_* abaixo são ignorados
# (src/config/typeorm.config.ts). Para usar os campos individuais (Docker local), apague ou comente a linha DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Alternativa à DATABASE_URL: campos individuais. Valem SÓ se DATABASE_URL NÃO estiver definida.
# O docker-compose.yml do backend expõe o banco na porta 5433; use em DB_PASS a mesma senha de POSTGRES_PASSWORD do docker-compose.yml.
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASS=
# DB_NAME=healthhub

# CORS em produção (separar por vírgula). Só é lida com NODE_ENV=production; fora de produção o CORS aceita apenas
# origens locais fixas (localhost nas portas 3000, 5173, 5174, 5175 e 4173). Ver src/main.ts.
ALLOWED_ORIGINS=https://seu-dominio.com

# Ambiente. Com NODE_ENV=production: CORS só pelas origens de ALLOWED_ORIGINS, limite de login de 10 tentativas por IP a cada 15 minutos
# (fora de produção são 100), Swagger desligado por padrão e logs de SQL do TypeORM desligados.
NODE_ENV=development

# Swagger (/api/docs). Padrão: ligado fora de produção e desligado em produção. SWAGGER_ENABLED=true liga em qualquer ambiente;
# SWAGGER_ENABLED=false desliga em qualquer ambiente. Ver src/config/swagger.ts.
# SWAGGER_ENABLED=false

# Usuários do seed (somente desenvolvimento). O seed PARA COM ERRO se faltar alguma SEED_*_SENHA. Sem SEED_*_EMAIL, valem os e-mails padrão abaixo.
SEED_MEDICO_EMAIL=medico@healthhub.com
SEED_MEDICO_SENHA=
SEED_RECEPCIONISTA_EMAIL=recepcionista@healthhub.com
SEED_RECEPCIONISTA_SENHA=
SEED_ENFERMEIRO_EMAIL=enfermeiro@healthhub.com
SEED_ENFERMEIRO_SENHA=

# Alertas de sinais vitais cujo limiar não tem fonte clínica registrada (fonte: null). Desde a rodada 3 NENHUM limiar está nessa condição,
# então hoje esta chave não desliga nenhum alerta real. Padrão: true. false desliga só limiares com fonte: null.
ALERTAS_SEM_FONTE=true
