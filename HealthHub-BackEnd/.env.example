PORT=3001

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Chave da API GROQ
GROQ_API_KEY=

# URL de conexão com o PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=

# Vite
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# CORS em produção (separar por vírgula)
ALLOWED_ORIGINS=https://seu-dominio.com

# Ambiente
NODE_ENV=development

# Senhas para o seed (somente desenvolvimento)
SEED_MEDICO_EMAIL=medico@healthhub.com
SEED_MEDICO_SENHA=
SEED_RECEPCIONISTA_EMAIL=recepcionista@healthhub.com
SEED_RECEPCIONISTA_SENHA=
SEED_ENFERMEIRO_EMAIL=enfermeiro@healthhub.com
SEED_ENFERMEIRO_SENHA=
