{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "modules/ai/data/cid10/*.CSV", "watchAssets": false }],
    "plugins": [{ "name": "@nestjs/swagger", "options": { "classValidatorShim": true, "introspectComments": false } }]
  }
}
